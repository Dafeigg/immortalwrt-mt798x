/dts-v1/;

#include "mt7981.dtsi"

/ {
	model = "PPLINK-S21";
	compatible = "mediatek,mt7981-rfb";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		reg = <0x40000000 0x10000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&pio 1 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_RESTART>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		led_status_red: status_red {
			label = "red:status";
			gpios = <&pio 8 GPIO_ACTIVE_LOW>;
		};

		led_status_blue: status_blue {
			label = "blue:status";
			gpios = <&pio 13 GPIO_ACTIVE_LOW>;
		};
	};
};

&uart0 {
	status = "okay";
};

&eth {
	status = "okay";

	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";
	};

	gmac1: mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		phy-mode = "gmii";
		phy-handle = <&phy0>;
	};

	mdio: mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;

		phy0: ethernet-phy@0 {
			reg = <0>;
		};

		switch: switch@0 {
			compatible = "mediatek,mt7531";
			reg = <0>;
			reset-gpios = <&pio 39 GPIO_ACTIVE_HIGH>;
		};
	};
};

&spi0 {
	status = "okay";

	spi_nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <52000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			factory: partition@180000 {
				label = "Factory";
				reg = <0x180000 0x200000>;
				read-only;
			};
		};
	};
};

&wmac {
	status = "okay";
	mediatek,mtd-eeprom = <&factory 0x0>;
};
